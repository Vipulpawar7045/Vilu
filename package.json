{
  "name": "vilu",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "start:local": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "monitor": "tsx scripts/run-monitoring.ts",
    "backup": "tsx scripts/backup-local.ts",
    "restore": "tsx scripts/restore-local.ts",
    "perf:check": "tsx scripts/performance-check.ts",
    "release:verify": "tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.3",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.0.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
